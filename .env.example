# Leave any key blank to run that stage in fake mode (deterministic, offline).

# Extraction: Claude fills the obligation form for each enforceable clause.
# Used whenever ANTHROPIC_API_KEY is set; otherwise OpenAI below.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Decisions: the OpenAI Decisions API (gpt-6-luna) classifies clauses, judges
# tool roles, runs the recipient check and verifies rules. Used whenever
# OPENAI_API_KEY is set. The same key is the extraction fallback (OPENAI_MODEL).
OPENAI_API_KEY=
OPENAI_DECISIONS_MODEL=gpt-6-luna
OPENAI_MODEL=gpt-5-mini

# TypeSafe JEV: the alternative decision model, used when there is no OpenAI
# key or when JUDGE_PROVIDER=typesafe.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Overrides (blank = choose from the keys above).
#   EXTRACT_PROVIDER  anthropic | openai | fake
#   JUDGE_PROVIDER    openai-decisions | typesafe | fake
#   EXTRACT_PROMPT    v2 (default) | v1 (the original form, without the
#                     consent / material-breach / applies questions)
EXTRACT_PROVIDER=
JUDGE_PROVIDER=
EXTRACT_PROMPT=v2

# Recipient check: a yes/no per clause, "does it limit who may receive the
# information?", so a clause filed as a use limit still yields access rules.
# 0 turns it off. Clauses at or above the threshold are read again.
RECIPIENT_CHECK=1
RECIPIENT_CHECK_THRESHOLD=0.8

# OpenBox backend (org key, obx_key_...), used to create / evaluate / activate rules.
OPENBOX_BACKEND_URL=https://api.openbox.ai
OPENBOX_ORG_API_KEY=
# Rules saved at once on Apply; each save rebuilds the agent's policy bundle.
OPENBOX_APPLY_CONCURRENCY=3

# OpenBox Core, used to govern the compiler agent itself (optional).
OPENBOX_API_URL=https://core.openbox.ai
COMPILER_OPENBOX_API_KEY=
COMPILER_OPENBOX_AGENT_NAME=NdaPolicyCompiler
COMPILER_OPENBOX_WORKLOAD_PRIVATE_KEY=

# Verifier score below which a generated rule is held for review (the CLI only
# auto-applies rules at or above it; the web Apply screen applies what is ticked).
VERIFY_THRESHOLD=0.8
